# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. .env.local NÃO vai para o Git.
# ---------------------------------------------------------------------------

# Connection string do Neon (Postgres serverless).
#   1. crie um projeto em https://console.neon.tech
#   2. copie a "Connection string" do branch main (modo "Pooled connection")
#   3. cole aqui e rode: npm run db:migrate
#
# Se ficar vazia, o app sobe com repositório EM MEMÓRIA (bom para desenvolver,
# inaceitável em produção — o composition root recusa subir sem ela em prod).
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para (1) hashear os sinais que identificam o aparelho de quem
# responde e (2) assinar o cookie de sessão do convidado.
#
# Sem ele o projeto sobe com um salt padrão que está no repositório — ou seja,
# não é segredo, e o espaço de IPv4 é pequeno o bastante para força bruta.
# Gere o seu:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Trocar este valor invalida todos os cookies e digests já gravados: quem já
# respondeu deixa de ser reconhecido. Defina uma vez, antes de divulgar o link.
RSVP_DEVICE_SALT=""

# ---------------------------------------------------------------------------
# Login do convidado (Auth.js)
# ---------------------------------------------------------------------------

# Assina o cookie de sessão. Gere com:  npx auth secret
AUTH_SECRET=""

# Google. Console: https://console.cloud.google.com/apis/credentials
#   1. Criar credencial > ID do cliente OAuth > Aplicativo da Web
#   2. Origens JavaScript autorizadas:  http://localhost:3000
#                                       https://SEU-DOMINIO.vercel.app
#   3. URIs de redirecionamento autorizados:
#        http://localhost:3000/api/auth/callback/google
#        https://SEU-DOMINIO.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Mensageria por e-mail (Ivy Messager)
# ---------------------------------------------------------------------------
# Sem o token nenhum e-mail e enviado, e o convite segue aceitando confirmacoes.
# Notificar e melhoria, nao requisito.

# Credencial do servico. Peca a quem opera o Ivy Messager.
IVY_MESSAGER_TOKEN=""

# Base URL. Ja tem o padrao no codigo; so defina para apontar outro ambiente.
# IVY_MESSAGER_BASE_URL="https://messager-lyart-nu.vercel.app"

# Quem recebe aviso a cada resposta. Separado por virgula. Vazio = ninguem.
RSVP_NOTIFY_EMAILS=""

# URL publica do convite, usada no botao dos e-mails.
# Na Vercel e inferida de VERCEL_PROJECT_PRODUCTION_URL; defina so para dominio
# proprio ou outra hospedagem.
# INVITATION_URL="https://ivy-invite-2.vercel.app"
